*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#0f172a;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.phone-frame{
    width:390px;
    height:780px;
    background:#111827;
    border-radius:40px;
    padding:20px;
    box-shadow:0 0 50px rgba(0,0,0,0.5);
}

.app{
    width:100%;
    height:100%;
    overflow:auto;
}

.top-bar{
    margin-top:20px;
    text-align:center;
}

.top-bar h1{
    color:#38bdf8;
    font-size:32px;
}

.top-bar p{
    color:#94a3b8;
    margin-top:10px;
}

.card{
    background:#1e293b;
    padding:20px;
    margin-top:30px;
    border-radius:20px;
}

input{
    width:100%;
    padding:15px;
    border:none;
    border-radius:15px;
    font-size:16px;
    background:#334155;
    color:white;
}

button{
    width:100%;
    margin-top:15px;
    padding:15px;
    border:none;
    border-radius:15px;
    background:#38bdf8;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#0ea5e9;
}

.result-card{
    margin-top:25px;
    background:#16a34a;
    padding:20px;
    border-radius:20px;
    color:white;
}

.result-card h2{
    margin-bottom:10px;
}

.tips{
    margin-top:25px;
    background:#1e293b;
    padding:20px;
    border-radius:20px;
    color:white;
}

.tips h3{
    margin-bottom:15px;
}

.tips ul{
    list-style:none;
}

.tips li{
    margin-bottom:12px;
    color:#cbd5e1;
}